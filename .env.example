# HTTP server configuration
HOST="" # Optiona: Leave empty to bind to all interfaces
PORT=10591 # Optional: Default is 10591

# Private key for the faucet
PRIVATE_KEY_BYTES="323b1d8f4eed5f0da9da93071b034f2dce9d2d22692c172f3cb252a64ddfafd01b057de320297c29ad0c1f589ea216869cf1938d88c9fbd70d6748323dbf2fa7" # Optional: Will use "00c4cb545f748a28770042f893784ce85b107389004d6a0e0d6d7518eeae1292d9" to sign transactions

# Nuklai RPC URL
NUKLAI_RPC="https://api-devnet.nuklaivm-dev.net:9650" # Required: Nuklai RPC endpoint

# Faucet configuration
AMOUNT=100000000
START_DIFFICULTY=25
SOLUTIONS_PER_SALT=10
TARGET_DURATION_PER_SALT=300

# Admin token for secure operations
ADMIN_TOKEN=YOUR_ADMIN_TOKEN

# User will be unable to request funds if their balance is greater than this value
BALANCE_THRESHOLD=25

# PostgreSQL configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DBNAME=nuklai-faucet-db
POSTGRES_ENABLESSL=false  # or true to enable SSL
